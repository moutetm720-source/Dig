# ============================================================
# DIG — Variables d'environnement
# Copier vers `.env` (ou définir dans le runtime). Toutes les
# valeurs ci-dessous sont des EXEMPLES — à personnaliser.
# ============================================================

# ---- Port du serveur (API + SPA) ----
PORT=3211

# ---- Base de données (Postgres) ----
# NB : db.ts utilise un port fixe (5432) — DB_PORT n'est pas lu.
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=applet
# Repli alternatif (préfixe SQL_) si les DB_* sont absents
#SQL_HOST=127.0.0.1
#SQL_USER=postgres
#SQL_PASSWORD=password
#SQL_DB_NAME=applet

# ---- SÉCURITÉ — session modérateur (PHASE 2) ----
# Secret HMAC qui signe les tokens de session (login /api/auth/login).
# OBLIGATOIRE en production : sans SESSION_SECRET, les tokens signés ne
# sont pas émis et seul le passcode direct (à chaque appel) fonctionne.
# Générer : openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# Passcode modérateur côté SERVEUR (source de vérité).
# S'il est défini : il s'impose (le back-office ne peut plus le modifier
# par l'UI) et le login s'y réfère. Sinon, le serveur lit la clé
# df_moderator_passcode de la base (posée via le back-office).
# FAIL-CLOSED : sans passcode côté serveur, les écritures modérateur sont
# refusées (plus de défaut faible '2026' ni de création aléatoire muette).
MODERATOR_PASSCODE=

# ---- Mode démo (SANS clé Stripe) ----
# '1' → active le tunnel de démo : commande PENDING créée côté serveur,
# livraison pilotée par /api/checkout/demo-complete (idempotent, token de
# téléchargement émis par le serveur). Sans ce flag, sans Stripe, le
# checkout est simplement inopérant (aucune livraison).
DEMO_CHECKOUT=1

# ---- Stripe ----
# Clé secrète (sk_test_... / sk_live_...). Peut aussi être stockée en base
# (df_stripe_sk) via le back-office ; l'environnement a priorité.
STRIPE_SECRET_KEY=
# Secret de signature des webhooks (whsec_...). Peut aussi être en base
# (df_stripe_whsec) ; l'environnement a priorité.
STRIPE_WEBHOOK_SECRET=

# ---- IA — moteur HERMES v4 (optionnel mais recommandé) ----
# Fournisseur du moteur d'agent Hermes : auto | gemini | openai | mock
#   auto  = gemini si GEMINI_API_KEY, sinon openai si HERMES_OPENAI_BASE_URL,
#           sinon mode hors-ligne honnête (actions outillées OK, pas d'IA)
#   gemini = Google AI Studio (gratuit) — GEMINI_API_KEY requise
#   openai = n'importe quel endpoint compatible OpenAI : Ollama local
#            (http://127.0.0.1:11434/v1), Groq, OpenRouter…
#   mock   = fournisseur déterministe de TEST (jamais en production)
HERMES_PROVIDER=auto
# Clé Gemini (Google AI Studio). L'environnement est la SEULE source
# (jamais stockée en base, jamais exposée aux clients).
GEMINI_API_KEY=
# Modèle Gemini par défaut (changeable via POST /api/hermes/config)
HERMES_GEMINI_MODEL=gemini-2.5-flash
# Endpoint compatible OpenAI + modèle + clé (Ollama local :
# HERMES_OPENAI_BASE_URL=http://127.0.0.1:11434/v1, HERMES_OPENAI_API_KEY=ollama)
HERMES_OPENAI_BASE_URL=
HERMES_OPENAI_MODEL=
HERMES_OPENAI_API_KEY=

# ---- IndexNow (optionnel) ----
# Clé d'IndexNow pour le submit automatique des pages publiques.
INDEXNOW_KEY=
