# ============================================================
# DIG — Variables d'environnement
# Copier vers `.env` (ou définir dans le runtime). Toutes les
# valeurs ci-dessous sont des EXEMPLES — à personnaliser.
# ============================================================

# ---- Port du serveur (API + SPA) ----
PORT=3211

# ---- Base de données (Postgres) ----
# Deux façons de brancher (db.ts gère les deux) :
#  A) DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
#     (RECOMMANDÉ — c'est ce que Render injecte si la base est liée au service ;
#      ⚠️ pour Render AJOUTER ?sslmode=require, Render exige le SSL)
#  B) Variables individuelles DB_* ci-dessous (dev local) :
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=applet
# DB_SSL : force le mode SSL (require | disable). Défaut auto : require
# pour un hôte *.render.com ou en production, sinon off (ex. dev local : disable).
# Repli alternatif (préfixe SQL_) si les DB_* sont absents
#SQL_HOST=127.0.0.1
#SQL_PORT=5432
#SQL_USER=postgres
#SQL_PASSWORD=password
#SQL_DB_NAME=applet

# ---- SÉCURITÉ — session modérateur (PHASE 2) ----
# Secret HMAC qui signe les tokens de session (login /api/auth/login).
# OBLIGATOIRE en production : sans SESSION_SECRET, les tokens signés ne
# sont pas émis et seul le passcode direct (à chaque appel) fonctionne.
# Générer : openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# Passcode modérateur côté SERVEUR (source de vérité).
# S'il est défini : il s'impose (le back-office ne peut plus le modifier
# par l'UI) et le login s'y réfère. Sinon, le serveur lit la clé
# df_moderator_passcode de la base (posée via le back-office).
# FAIL-CLOSED : sans passcode côté serveur, les écritures modérateur sont
# refusées (plus de défaut faible '2026' ni de création aléatoire muette).
MODERATOR_PASSCODE=

# ---- Paiement 100 % RÉEL (ancien mode démo SUPPRIMÉ) ----
# DEMO_CHECKOUT n'existe plus : aucune commande n'est créée ni livrée sans
# paiement vérifié (webhook Stripe signé ou contrôle on-chain). Sans clé
# Stripe, le checkout est simplement inopérant (aucune livraison gratuite).
# Commandes héritées de l'ancien mode démo : skill Hermes data_reality_audit
# puis data_purge_demo (confirmation requise).

# ---- Stripe ----
# Clé secrète (sk_test_... / sk_live_...). Peut aussi être stockée en base
# (df_stripe_sk) via le back-office ; l'environnement a priorité.
STRIPE_SECRET_KEY=
# Secret de signature des webhooks (whsec_...). Peut aussi être en base
# (df_stripe_whsec) ; l'environnement a priorité.
STRIPE_WEBHOOK_SECRET=

# ---- IA — moteur HERMES v5 (RÉEL UNIQUEMENT) ----
# Fournisseur du moteur d'agent Hermes : auto | gemini | openai
# ⚠️ « mock » (ancien mode TEST) a été SUPPRIMÉ : Hermes ne simule jamais
# d'IA. S'il est encore présent dans l'environnement ou en base, il est
# ignoré avec un avertissement et « auto » s'applique.
# Sémantique du POOL multi-fournisseurs (bascule automatique anti-blocage :
# un fournisseur en 429/erreur passe en cooldown et le suivant est essayé) :
#   auto   = fournisseurs d'env (gemini si GEMINI_API_KEY, openai si
#            HERMES_OPENAI_BASE_URL) + pool géré (ajouté au runtime)
#   gemini = verrou exclusif Gemini (Google AI Studio, gratuit) — GEMINI_API_KEY requise
#   openai = verrou exclusif endpoint compatible OpenAI : Ollama local
#            (http://127.0.0.1:11434/v1), Groq, OpenRouter…
# Sans aucun fournisseur réel : Hermes l'annonce et exécute ses skills sur
# des données réelles (aucune réponse inventée).
# Le pool géré (clé KV df_hermes_provider_pool, protégée) est piloté par
# Hermes lui-même : « ajoute Groq au pool », « liste les fournisseurs »…
# (skills providers_* ou REST /api/hermes/providers). Les clés/token y sont
# masquées partout — jamais en clair (UI, API, audit, logs).
HERMES_PROVIDER=auto
# Mode strict par défaut : local, modèles OpenRouter :free, anonymes connus sans clé.
# Gemini/Groq/autres clés : coût inconnu, donc exclus en mode strict (pas de repli payant).
# Pour un appel payant choisi par l'opérateur : 0 ET freeOnly:false via l'API.
# L'interface reste en freeOnly:true. Hébergement/frais de paiement non inclus.
HERMES_FREE_ONLY=1
# 0 = pas d'ajout automatique d'endpoints anonymes tiers. Pour du local uniquement,
# choisir aussi HERMES_PROVIDER=openai et un modèle réellement local (pas :cloud).
HERMES_ANONYMOUS_FALLBACK=1
# Clé Gemini (Google AI Studio). L'environnement est la SEULE source
# (jamais stockée en base, jamais exposée aux clients).
GEMINI_API_KEY=
# Modèle Gemini par défaut (changeable via POST /api/hermes/config).
# ⚠️ gemini-2.5-flash est DÉPRÉCIÉ pour les nouvelles clés API (404
# « no longer available to new users » — arrêt officiel 20/10/2026).
# Modèles actuels conseillés : gemini-3.5-flash-lite (défaut, remplaçant
# recommandé), gemini-3.8-flash (dernier), gemini-3.5-flash.
# En cas de 404 « modèle déprécié », Hermes bascule automatiquement sur un
# modèle disponible (chaîne GEMINI_MODEL_FALLBACKS de hermes/providers.ts).
HERMES_GEMINI_MODEL=gemini-3.5-flash-lite
# Endpoint compatible OpenAI + modèle + clé. Deux options :
#  A) IA LOCALE (gratuite, réelle, sans clé cloud) — installation guidée :
#     node scripts/setup-local-llm.mjs
#     → installe/démarre Ollama (ou llama-server en secours), télécharge un
#       modèle avec support des tools (qwen2.5:1.5b par défaut) et affiche
#       les lignes ci-dessous à copier.
#     HERMES_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#     HERMES_OPENAI_MODEL=qwen2.5:1.5b
#     HERMES_OPENAI_API_KEY=ollama
#  B) Endpoint cloud compatible OpenAI : Groq (https://api.groq.com/openai/v1),
#     OpenRouter (https://openrouter.ai/api/v1), Together, Mistral…
HERMES_OPENAI_BASE_URL=
HERMES_OPENAI_MODEL=
HERMES_OPENAI_API_KEY=

# ---- Providers gratuits 100% FREE (optionnels, free tier permanent) ----
# Ces clés sont 100% gratuites, sans CB, et auto-détectées au démarrage par
# hermes/freeProviders.ts → autoInstallFreeProviders() → pool KV.
# Même sans aucune clé, Hermes fonctionne via OVH (2 RPM/IP anonyme) et LLM7.io (turbo anonyme).
# Catalogue complet : GET /api/hermes/free-catalog ou skill free_catalog
# - Groq : https://console.groq.com/keys (ultra-rapide LPU, 30 RPM free, sans CB)
GROQ_API_KEY=
# - OpenRouter : https://openrouter.ai/keys (modèles :free, 20 RPM, 50 RPD)
OPENROUTER_API_KEY=
# - Mistral : https://console.mistral.ai/api-keys (free mode $10/mois)
MISTRAL_API_KEY=
# - Cohere : https://dashboard.cohere.com/api-keys (1000 calls/mois free trial)
COHERE_API_KEY=
# - HuggingFace : https://huggingface.co/settings/tokens ($0.10 free)
HF_TOKEN=
# - Together AI : https://api.together.xyz/settings/api-keys (free credits)
TOGETHER_API_KEY=
# - NVIDIA NIM : https://build.nvidia.com/explore/discover (free dev program)
NVIDIA_API_KEY=
# - OVHcloud AI Endpoints & LLM7.io : AUCUNE CLÉ (déjà actifs en fallback anonyme)
#   OVH : https://oai.endpoints.kepler.ai.cloud.ovh.net/v1 — 2 RPM/IP, 20+ modèles EU
#   LLM7 : https://api.llm7.io/v1 — turbo models gratuits anonymes

# ---- Données 100 % RÉELLES ----
# '1' (défaut) = aucun chiffre inventé : ventes, conversions, vues, clics,
# abonnés, tendances de marché… ne sont JAMAIS générés aléatoirement. Les
# métriques restent à 0 (« non mesuré ») tant qu'aucune source réelle n'est
# branchée (API plateforme, Search Console, Stripe, marché…).
# '0' = reactive les anciens générateurs simulés (démo isolée UNIQUEMENT —
#       jamais en production : les chiffres affichés seraient faux).
DIG_REAL_DATA_ONLY=1

# ---- IndexNow (optionnel) ----
# Clé d'IndexNow pour le submit automatique des pages publiques.
INDEXNOW_KEY=

# ---- URL publique du service (optionnel mais recommandé) ----
# Utilisée par le docteur de code (stripe_doctor) pour rappeler l'URL exacte du
# webhook à déclarer dans le dashboard Stripe : https://<service>/api/webhooks/stripe
PUBLIC_URL=
